<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Мій домашній улюбленець</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f9;
            color: #333;
            margin: 0;
            padding: 20px;
            text-align: center;
        }

        header {
            background-color: #4CAF50;
            color: white;
            padding: 15px 0;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        h1 {
            margin: 0;
            font-size: 28px;
        }

        .media-gallery {
            display: flex;
            justify-content: center;
            gap: 30px;
            flex-wrap: wrap;
            margin-top: 20px;
        }

        .card {
            background: white;
            border-radius: 10px;
            padding: 20px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            width: 300px;
            box-sizing: border-box;
        }

        .card img {
            width: 80px;
            height: 80px;
            object-fit: contain;
            margin-bottom: 10px;
        }

        .card h2 {
            font-size: 20px;
            color: #4CAF50;
            margin-bottom: 15px;
        }

        audio, video {
            width: 100%;
            border-radius: 6px;
        }

        footer {
            margin-top: 30px;
            font-size: 14px;
            color: #666;
        }
    </style>
</head>
<body>

    <header>
        <h1>Мій домашній улюбленець</h1>
    </header>

    <main class="media-gallery">
        <!-- Блок Аудіо (Музика) -->
        <div class="card">
            <img src="music_icon.png" alt="Музика">
            <h2>Музика / Розповідь</h2>
            <audio controls>
                <source src="audio.mp3" type="audio/mpeg">
                Ваш браузер не підтримує аудіоелемент.
            </audio>
        </div>

        <!-- Блок Відео -->
        <div class="card">
            <img src="video_icon.png" alt="Відео">
            <h2>Відеоролик</h2>
            <video controls poster="preview.jpg">
                <source src="video.mp
